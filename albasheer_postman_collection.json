{
  "info": {
    "name": "Albasheer Electricals API",
    "_postman_id": "albasheer-electricals-api-v1",
    "description": "Complete API collection for the Albasheer Electricals Django REST Framework backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Staff Auth",
      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "}",
                  "if (json.refresh) {",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+963911000001\",\n  \"password\": \"admin1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/staff/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "staff", "login", ""]
            },
            "description": "Login for branch_manager, delivery, and admin roles. Returns access + refresh JWT tokens and user profile (id, phone, full_name, role, branch_id, branch_name). Tokens are auto-saved to collection variables. Returns 403 if role is customer."
          },
          "response": []
        },
        {
          "name": "Staff Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/staff/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "staff", "refresh", ""]
            },
            "description": "Exchange a refresh token for a new access token. New access_token is auto-saved to collection variables."
          },
          "response": []
        },
        {
          "name": "Staff Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/staff/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "staff", "me", ""]
            },
            "description": "Returns the authenticated staff user's profile: id, phone, full_name, role, branch_id, branch_name. Returns 401 if no/invalid token. Returns 403 if the token belongs to a customer."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0912345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/request-code/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "request-code", ""]
            },
            "description": "Send a 5-digit OTP to the phone number via WhatsApp. Phone is normalized to E.164 (+963...)."
          },
          "response": []
        },
        {
          "name": "Verify OTP Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "}",
                  "if (json.refresh) {",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"code\": \"48219\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/verify-code/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "verify-code", ""]
            },
            "description": "Verify the 5-digit OTP code. Creates user account on first login. Returns access + refresh JWT tokens and is_new flag. Tokens are auto-saved to collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "description": "Refresh the JWT access token. New access_token is auto-saved."
          },
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            },
            "description": "Returns: id, phone, first_name, last_name, role, address."
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"أحمد\",\n  \"last_name\": \"البشير\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            },
            "description": "Partially update profile. Writable fields: first_name, last_name, address."
          },
          "response": []
        }
      ]
    },
